<%- include('partials/head', { pageTitle: "Sign in — Climate Solutions" }) %>

<section class="mx-auto max-w-md px-5 py-16">

  <h1 class="font-display text-2xl">Sign in</h1>
  <p class="mt-2 text-sm text-muted">
    Signing in lets you add, edit and remove solutions. Browsing does not require an account.
  </p>

  <% if (errorMessage) { %>
    <div class="mt-6 border border-transport bg-transport/5 px-4 py-3 text-sm text-transport">
      <%= errorMessage %>
    </div>
  <% } %>

  <form method="POST" action="/login" class="mt-6 bg-surface border border-rule p-6 flex flex-col gap-4">

    <div>
      <label class="label" for="userName">User name</label>
      <input id="userName" type="text" name="userName" class="field"
             value="<%= userName %>" autocomplete="username" required />
    </div>

    <div>
      <label class="label" for="password">Password</label>
      <input id="password" type="password" name="password" class="field"
             autocomplete="current-password" required />
    </div>

    <button type="submit" class="btn-solid mt-1">Sign in</button>

  </form>

</section>

<%- include('partials/foot') %>
