<%- include('partials/head', { pageTitle: "Edit " + project.title + " — Climate Solutions" }) %>

<section class="mx-auto max-w-2xl px-5 py-12">

  <a href="/solutions/projects/<%= project.id %>" class="text-sm text-muted hover:text-ink">Back to the solution</a>

  <h1 class="mt-4 font-display text-3xl">Edit solution</h1>
  <p class="mt-2 text-muted"><%= project.title %></p>

  <form method="POST" action="/solutions/editProject" class="mt-8 bg-surface border border-rule p-6 flex flex-col gap-5">

    <input type="hidden" name="id" value="<%= project.id %>" />

    <div>
      <label class="label" for="title">Title</label>
      <input id="title" type="text" name="title" class="field" value="<%= project.title %>" required />
    </div>

    <div>
      <label class="label" for="sector_id">Sector</label>
      <select id="sector_id" name="sector_id" class="field" required>
        <% sectors.forEach(sec => { %>
          <option value="<%= sec.id %>" <%= project.sector_id == sec.id ? "selected" : "" %>>
            <%= sec.sector_name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div>
      <label class="label" for="feature_img_url">Image address</label>
      <input id="feature_img_url" type="url" name="feature_img_url" class="field"
             value="<%= project.feature_img_url %>" required />
    </div>

    <div>
      <label class="label" for="summary_short">Summary</label>
      <textarea id="summary_short" name="summary_short" rows="2" class="field" required><%= project.summary_short %></textarea>
      <p class="mt-1 text-xs text-muted">One or two sentences. This is what shows on the cards.</p>
    </div>

    <div>
      <label class="label" for="intro_short">What it is</label>
      <textarea id="intro_short" name="intro_short" rows="4" class="field" required><%= project.intro_short %></textarea>
    </div>

    <div>
      <label class="label" for="impact">Why it matters</label>
      <textarea id="impact" name="impact" rows="4" class="field" required><%= project.impact %></textarea>
    </div>

    <div>
      <label class="label" for="original_source_url">Source address</label>
      <input id="original_source_url" type="url" name="original_source_url" class="field"
             value="<%= project.original_source_url %>" required />
    </div>

    <div class="flex gap-3 pt-1">
      <button type="submit" class="btn-solid">Save changes</button>
      <a href="/solutions/projects/<%= project.id %>" class="btn-quiet">Cancel</a>
    </div>

  </form>

</section>

<%- include('partials/foot') %>
