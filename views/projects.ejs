<%- include('partials/head', { pageTitle: "Solutions — Climate Solutions" }) %>

<section class="bg-surface border-b border-rule">
  <div class="mx-auto max-w-6xl px-5 py-10">

    <h1 class="font-display text-3xl">
      <%= activeSector ? activeSector : "All solutions" %>
    </h1>

    <p class="mt-2 text-muted">
      <%= projects.length %> <%= projects.length === 1 ? "solution" : "solutions" %><%= activeSector ? " in this sector" : "" %>
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      <a href="/solutions/projects"
         class="text-sm px-3 py-1.5 border rounded-full <%= activeSector ? 'border-rule text-muted hover:border-ink hover:text-ink' : 'border-ink text-ink' %>">
        All
      </a>
      <% sectors.forEach(sec => { const s = sector(sec.sector_name); const on = activeSector === sec.sector_name; %>
        <a href="/solutions/projects?sector=<%= encodeURIComponent(sec.sector_name) %>"
           class="text-sm px-3 py-1.5 border rounded-full <%= on ? s.chip + ' font-medium' : 'border-rule text-muted hover:border-ink hover:text-ink' %>">
          <%= sec.sector_name %>
        </a>
      <% }) %>
    </div>

  </div>
</section>

<section class="mx-auto max-w-6xl px-5 py-10">
  <% if (projects.length) { %>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% projects.forEach(project => { %>
        <%- include('partials/card', { project: project }) %>
      <% }) %>
    </div>
  <% } else { %>
    <div class="border border-rule bg-surface p-10 text-center">
      <p class="font-display text-xl">Nothing here yet</p>
      <p class="mt-2 text-muted">No solutions are listed in this sector.</p>
      <a href="/solutions/projects" class="btn-solid mt-6">Browse all solutions</a>
    </div>
  <% } %>
</section>

<%- include('partials/foot') %>
