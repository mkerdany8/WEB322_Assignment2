<!DOCTYPE html>
<html lang="en" data-theme="cupcake">
<head>
  <meta charset="UTF-8" />
  <title>Climate Solutions – Projects</title>
  <link rel="stylesheet" href="/css/main.css" />
</head>

<body>


  <%- include('partials/navbar') %>

  
  <div class="hero">
    <div class="hero-content text-center">
      <h1>Climate Projects</h1>
      <p>Explore all solutions or filter by sector below.</p>

      <!-- Add Project button -->
      <% if (locals.session && locals.session.user) { %>
        <a href="/solutions/addProject" class="btn btn-success mb-4">Add Project</a>
      <% } %>

      <!-- Manual Sector Filter Buttons -->
      <div class="flex justify-center gap-4 mt-4 flex-wrap">
        <a href="/solutions/projects" class="btn btn-outline btn-primary">All</a>
        <a href="/solutions/projects?sector=Industry" class="btn btn-outline">Industry</a>
        <a href="/solutions/projects?sector=Transportation" class="btn btn-outline">Transportation</a>
        <a href="/solutions/projects?sector=Electricity" class="btn btn-outline">Electricity</a>
        <a href="/solutions/projects?sector=Land Sinks" class="btn btn-outline">Land Sinks</a>
        <a href="/solutions/projects?sector=Buildings" class="btn btn-outline">Buildings</a>
      </div>
    </div>
  </div>

  <!-- Projects Table -->
  <div class="container mx-auto mt-6">
    <table class="table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Sector</th>
          <th>Summary</th>
          <th>Action</th>
        </tr>
      </thead>

      <tbody>
        <% projects.forEach(project => { %>
          <tr>
            <td><%= project.title %></td>

            <!-- Sector Links -->
            <td>
              <a href="/solutions/projects?sector=<%= project.Sector?.sector_name %>" class="btn btn-outline btn-xs">
                <%= project.Sector?.sector_name %>
              </a>
            </td>

            <td><%= project.summary_short %></td>

            <td class="flex gap-2">

              <!-- View Details -->
              <a href="/solutions/projects/<%= project.id %>" class="btn btn-primary btn-xs">Details</a>

              <!-- SHOW Edit + Delete ONLY IF LOGGED IN -->
              <% if (locals.session && locals.session.user) { %>
                <a href="/solutions/editProject/<%= project.id %>" class="btn btn-warning btn-xs">Edit</a>
                <a href="/solutions/deleteProject/<%= project.id %>" class="btn btn-error btn-xs">Delete</a>
              <% } %>

            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</body>
</html>
