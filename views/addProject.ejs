<%- include('partials/navbar') %>

<h1 class="text-3xl font-bold mb-6">Add Project</h1>

<form method="POST" action="/solutions/addProject" class="space-y-4">

    <input type="text" name="title" placeholder="Title" required class="input input-bordered w-full" />

    <input type="url" name="feature_img_url" placeholder="Feature Image URL" required class="input input-bordered w-full" />

    <select name="sector_id" required class="select select-bordered w-full">
        <option value="">Select Sector</option>
        <option value="1">Land Sinks</option>
        <option value="2">Industry</option>
        <option value="3">Transportation</option>
        <option value="4">Electricity</option>
        <option value="5">Food, Agriculture, and Land Use</option>
    </select>

    <textarea name="intro_short" placeholder="Intro Short" required class="textarea textarea-bordered w-full"></textarea>

    <textarea name="summary_short" placeholder="Summary Short" required class="textarea textarea-bordered w-full"></textarea>

    <textarea name="impact" placeholder="Impact" required class="textarea textarea-bordered w-full"></textarea>

    <input type="url" name="original_source_url" placeholder="Source URL" required class="input input-bordered w-full" />

    <button class="btn btn-success w-full">Add Project</button>
</form>
