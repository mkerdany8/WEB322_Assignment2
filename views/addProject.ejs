<%- include('partials/head', { pageTitle: "Add a solution — Climate Solutions" }) %>

<section class="mx-auto max-w-2xl px-5 py-12">

  <h1 class="font-display text-3xl">Add a solution</h1>
  <p class="mt-2 text-muted">It appears in the catalogue as soon as you save it.</p>

  <form method="POST" action="/solutions/addProject" class="mt-8 bg-surface border border-rule p-6 flex flex-col gap-5">

    <div>
      <label class="label" for="title">Title</label>
      <input id="title" type="text" name="title" class="field" required />
    </div>

    <div>
      <label class="label" for="sector_id">Sector</label>
      <select id="sector_id" name="sector_id" class="field" required>
        <option value="">Choose a sector</option>
        <% sectors.forEach(sec => { %>
          <option value="<%= sec.id %>"><%= sec.sector_name %></option>
        <% }) %>
      </select>
    </div>

    <div>
      <label class="label" for="feature_img_url">Image address</label>
      <input id="feature_img_url" type="url" name="feature_img_url" class="field"
             placeholder="https://" required />
    </div>

    <div>
      <label class="label" for="summary_short">Summary</label>
      <textarea id="summary_short" name="summary_short" rows="2" class="field" required></textarea>
      <p class="mt-1 text-xs text-muted">One or two sentences. This is what shows on the cards.</p>
    </div>

    <div>
      <label class="label" for="intro_short">What it is</label>
      <textarea id="intro_short" name="intro_short" rows="4" class="field" required></textarea>
    </div>

    <div>
      <label class="label" for="impact">Why it matters</label>
      <textarea id="impact" name="impact" rows="4" class="field" required></textarea>
    </div>

    <div>
      <label class="label" for="original_source_url">Source address</label>
      <input id="original_source_url" type="url" name="original_source_url" class="field"
             placeholder="https://" required />
    </div>

    <div class="flex gap-3 pt-1">
      <button type="submit" class="btn-solid">Save solution</button>
      <a href="/solutions/projects" class="btn-quiet">Cancel</a>
    </div>

  </form>

</section>

<%- include('partials/foot') %>
